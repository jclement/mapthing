# Copy to .env (chmod 600). Never commit .env.

# Admin login for /admin.
ADMIN_USER=admin
ADMIN_PASSWORD=

# The public address, used in styles and TileJSON (no trailing slash).
MAPTHING_PUBLIC_URL=https://maps.example.com

# The server is only reached through the tunnel, so take each client's address from the
# tunnel's headers (CF-Connecting-IP, else X-Forwarded-For). Login throttling, per-client rate
# limits and the logs then see real clients instead of the tunnel. Turn this off if you
# publish port 8080 directly: a client could then claim any address.
MAPTHING_TRUSTED_PROXY=on

# Cloudflare Tunnel token: Zero Trust > Networks > Tunnels > Create (cloudflared),
# then add a public hostname pointing at service http://mapthing:8080.
TUNNEL_TOKEN=

# Optional: pin an image (e.g. sha-242aefa) instead of latest.
# MAPTHING_TAG=latest
