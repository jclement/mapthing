# Copy to .env (chmod 600). Never commit .env.

# Admin login for /admin.
ADMIN_USER=admin
ADMIN_PASSWORD=

# The public address, used in styles and TileJSON (no trailing slash).
MAPTHING_PUBLIC_URL=https://maps.example.com

# Cloudflare Tunnel token: Zero Trust > Networks > Tunnels > Create (cloudflared),
# then add a public hostname pointing at service http://mapthing:8080.
TUNNEL_TOKEN=

# Optional: pin an image (e.g. sha-242aefa) instead of latest.
# MAPTHING_TAG=latest
