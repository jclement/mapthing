+  /** mapthing: OSM surface values grouped into paved and unpaved; null when unknown. */
+  static final class MapthingSurface {
+    private static final java.util.Set<String> PAVED = java.util.Set.of("paved", "asphalt", "concrete",
+      "concrete:plates", "concrete:lanes", "paving_stones", "paving_stones:lanes", "sett", "cobblestone",
+      "unhewn_cobblestone", "bricks", "chipseal", "metal", "metal_grid", "wood", "rubber", "tartan");
+    private static final java.util.Set<String> UNPAVED = java.util.Set.of("unpaved", "gravel", "fine_gravel",
+      "compacted", "dirt", "earth", "ground", "grass", "grass_paver", "gravel_turf", "mud", "sand", "pebblestone",
+      "rock", "shells", "woodchips", "salt", "clay", "snow", "ice");
+
+    private MapthingSurface() {}
+
+    static String normalize(String raw) {
+      if (raw == null) {
+        return null;
+      }
+      String v = raw.split(";", 2)[0].trim().toLowerCase(java.util.Locale.ROOT);
+      if (PAVED.contains(v)) {
+        return "paved";
+      }
+      if (UNPAVED.contains(v)) {
+        return "unpaved";
+      }
+      return null;
+    }
+  }
